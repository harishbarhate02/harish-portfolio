# Email Configuration
# 
# For LOCAL DEVELOPMENT:
# 1. Copy this file to server/.env
# 2. Replace the values below with your actual Gmail credentials
# 3. Use a Gmail App Password (not your regular password)
#    How to get: https://support.google.com/accounts/answer/185833
#
# For VERCEL DEPLOYMENT:
# 1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Add these three variables with your actual values
# 3. Select all environments (Production, Preview, Development)
# 4. Redeploy after adding variables

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
RECEIVER_EMAIL=your-email@gmail.com
